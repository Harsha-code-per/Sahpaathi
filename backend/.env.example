# Local dev: cp .env.example .env (in backend/). Never commit .env.
# Production (Render): set these as environment variables in the service settings; no .env file there.
DATABASE_URL=postgresql+psycopg://sahpaathi:sahpaathi@localhost:5432/sahpaathi
JWT_SECRET=change-me
# Password of the three demo accounts (teacher/reviewer/admin@sahpaathi.test), seeded by app/seed.py
DEMO_PASSWORD=
# New lessons the Studio may write per UTC day (~$1 of Claude credits each)
GENERATE_DAILY_LIMIT=10
CORS_ORIGINS=["http://localhost:5173"]

# Anthropic Claude: episode scriptwriter (Sonnet 5.5) and guardrail judge (Haiku 5.5). Owner: M1
ANTHROPIC_API_KEY=

# Indic TTS (Tamil/Hindi/Odia). Provider chosen on Day 1-2. Owner: M3
TTS_API_KEY=

# Pack signing (Ed25519 private key, base64). Owner: M3
PACK_SIGNING_KEY=

# Real catch-up calls through Exotel (docs/EXOTEL.md). Empty: only the Admin simulator works.
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_FLOW_ID=
EXOTEL_WEBHOOK_KEY=
PUBLIC_API_URL=
# The only numbers real calls may ring (team phones), comma-separated: the demo admin login is public
EXOTEL_ALLOWED_NUMBERS=

# Online teacher perception endpoint (docs/SENSE.md); off until legal review and parental consent
SENSE_ENABLED=false
