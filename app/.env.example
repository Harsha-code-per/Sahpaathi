# Local dev: cp .env.example .env (in app/). Production: set in the Vercel/Pages project settings.
# Vite inlines VITE_* values into the public JS bundle at build time: never put secrets here.
VITE_API_URL=http://localhost:8000
# Ed25519 public key (raw 32 bytes, base64) that voice/ signs .sahpaathi packs with. Public by design: it can only verify.
VITE_PACK_PUBLIC_KEY=
# Demo build only: shown on the Studio/Admin sign-in so evaluators can log in. Same value as DEMO_PASSWORD on the backend. Public by design; use it only for the test accounts.
VITE_DEMO_PASSWORD=
# Online teacher: show the opt-in camera/mic perception panel (docs/SENSE.md). Leave off for children.
VITE_SENSE_ENABLED=false
